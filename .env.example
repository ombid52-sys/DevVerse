# DevVerse Environment Configuration

# App
APP_URL=http://localhost:3000
NODE_ENV=development
SESSION_SECRET=devverse-ultra-secure-random-session-secret-key-at-least-32-chars

# MongoDB
MONGODB_URI=mongodb://localhost:27017/devverse

# Google Drive (Persistent Source Code Storage)
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Email Provider Configuration (Nodemailer)
# Use "smtp" for real email or leave blank / "development" to log codes to console
EMAIL_PROVIDER=development
EMAIL_FROM="DevVerse" <no-reply@devverse.io>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Initial Setup / Admin Bootstrap Token (Optional safety token for initial /api/admin/init setup)
ADMIN_BOOTSTRAP_TOKEN=devverse-setup-secure-key-2026
